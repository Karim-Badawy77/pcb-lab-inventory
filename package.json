{
    "name": "pcb-lab-inventory-api",
    "version": "1.0.0",
    "private": true,
    "engines": {
        "node": ">=24.0.0"
    },
    "main": "src/server.js",
    "scripts": {
        "start": "node scripts/start.js",
        "dev": "concurrently \"node --watch src/server.js\" \"vite --config frontend/vite.config.js --host 0.0.0.0\"",
        "build": "vite build --config frontend/vite.config.js",
        "test:frontend": "vitest run --config frontend/vite.config.js",
        "test": "jest --runInBand",
        "test:watch": "jest --watch"
    },
    "dependencies": {
        "cors": "^2.8.6",
        "dotenv": "^17.0.0",
        "express": "^5.0.0",
        "mongoose": "^9.0.0",
        "multer": "^2.0.0",
        "vue": "^3.5.43",
        "vue-router": "^5.3.1"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^6.0.8",
        "@vue/test-utils": "^2.5.0",
        "concurrently": "^9.2.1",
        "jest": "^30.0.0",
        "jsdom": "^30.0.1",
        "mongodb-memory-server": "^10.0.0",
        "supertest": "^7.0.0",
        "vite": "^8.2.2",
        "vitest": "^4.1.11"
    },
    "jest": {
        "testPathIgnorePatterns": [
            "/node_modules/",
            "/frontend/"
        ]
    },
    "allowScripts": {
        "@parcel/watcher@2.6.0": true,
        "mongodb-memory-server@10.4.3": true,
        "unrs-resolver@1.12.2": true
    }
}
